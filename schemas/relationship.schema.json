{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Atlas Relationship",

  "description": "Relationship between Atlas objects.",

  "type": "object",

  "required": [
    "id",
    "from",
    "to",
    "type"
  ],

  "properties": {
    "id": {
      "type": "string"
    },

    "from": {
      "type": "string"
    },

    "to": {
      "type": "string"
    },

    "type": {
      "type": "string",
      "enum": [
        "RELATED_TO",
        "SUPPORTS",
        "CONTRADICTS",
        "CAUSES",
        "DEPENDS_ON",
        "PART_OF",
        "DISCOVERS",
        "ANSWERS",
        "QUESTIONS"
      ]
    }
  }
}
