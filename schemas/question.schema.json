{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Atlas Question",

  "description": "Research Question object used inside Atlas Engine.",

  "type": "object",

  "required": [
    "id",
    "title",
    "description",
    "status",
    "priority",
    "confidence"
  ],

  "properties": {
    "id": {
      "type": "string"
    },

    "title": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "UNDER_RESEARCH",
        "PARTIALLY_ANSWERED",
        "ANSWERED"
      ]
    },

    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
